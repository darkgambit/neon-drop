# ─────────────────────────────────────────────────────────────
#  SECRETS — never commit these
# ─────────────────────────────────────────────────────────────
DEPLOY_SECRETS.local.md
.env
.env.*
*.key
*.pem

# Local working notes — holds account/dashboard detail, never publish
NEXT_ACTIONS.md

# ─────────────────────────────────────────────────────────────
#  Verification harness — the harness itself IS committed, because the deploy
#  payload is allowlisted through tools/build-site.mjs, so there is no longer
#  any reason to keep it out of git. Only its bulky output is ignored.
# ─────────────────────────────────────────────────────────────
.verify/out*/
.verify/shots*/
.verify/tmp/
node_modules/
package.json
package-lock.json
.vscode/
.idea/
*.swp

# ─────────────────────────────────────────────────────────────
#  OS cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
dist/

# Staged deploy output (regenerated by tools/build-site.mjs)
_site/

# Local Netlify folder
.netlify
